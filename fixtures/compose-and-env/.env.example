# The Prisma datasource reads this; host `db` is the compose service.
DATABASE_URL=postgresql://app:app@db:5432/app
# Served by the compose `cache` service on its published port.
REDIS_URL=redis://localhost:6379
# Neither compose nor Prisma explains this one: an env-only datastore.
SEARCH_DB_URL=mongodb://search.example.internal:27017/search
PORT=3000

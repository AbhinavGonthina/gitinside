{
  "name": "@gitinside/bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p render/tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bench": "node dist/analysis.js",
    "bench:stress": "node dist/stress.js",
    "bench:render": "vite build --config render/vite.config.ts && node dist/render.js"
  },
  "dependencies": {
    "@gitinside/analyzer": "workspace:*",
    "@gitinside/schema": "workspace:*",
    "@gitinside/viewer": "workspace:*",
    "@gitinside/worker": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}

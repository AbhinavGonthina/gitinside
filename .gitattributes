* text=auto
# Shell scripts and hooks must keep LF endings or Git Bash / macOS / Linux sh will choke on \r.
*.sh text eol=lf
scripts/hooks/* text eol=lf
*.ps1 text eol=crlf
# Golden graphs embed content hashes of fixture files, so fixtures must be byte-identical on every OS.
fixtures/** text eol=lf
# `pnpm eval --check` compares committed reports byte-for-byte with regenerated (LF) text.
eval/results/** text eol=lf
# Drizzle records a hash of each migration's SQL, so keep the bytes identical on every OS.
packages/db/drizzle/** text eol=lf
# Visual baselines and review screenshots are compared byte-for-byte.
*.png binary

# Environment variables for apps/web (ADR-0055). NAMES ONLY: never put a value
# in this file or any other file in the repo.
#
# Production values live only in Vercel (Production, marked Sensitive).
# Development points these at Docker Postgres (infra/docker-compose.dev.yml,
# whose local-only URL is in that file) and a local storage stand-in
# (M5.5), never at production.
#
# /api/analyze reads DATABASE_URL, WORKER_URL, ENQUEUE_HMAC_SECRET, and the
# optional GITHUB_TOKEN; without the first three it answers "temporarily
# unavailable" (ADR-0066). /api/graph reads DATABASE_URL and the SNAPSHOTS_*
# variables; repo pages need DATABASE_URL, plus the worker to re-analyze new
# commits (ADR-0068). /api/jobs reads only DATABASE_URL (ADR-0139).
# `pnpm --filter @gitinside/db migrate` reads
# DATABASE_URL_UNPOOLED, else DATABASE_URL.

# Neon pooled connection string (serverless functions).
DATABASE_URL=
# Neon direct connection string (migrations only).
DATABASE_URL_UNPOOLED=

# Oracle Object Storage (snapshots, ADR-0095): namespace, region identifier
# (e.g. us-ashburn-1), a Customer Secret Key, and the bucket.
SNAPSHOTS_NAMESPACE=
SNAPSHOTS_REGION=
SNAPSHOTS_ACCESS_KEY_ID=
SNAPSHOTS_SECRET_ACCESS_KEY=
SNAPSHOTS_BUCKET=

# The worker's enqueue API (https://worker.gitinside.abhinavgonthina.dev).
WORKER_URL=
# Shared HMAC key for enqueue requests: 32 random bytes, base64url. Also keys
# the rate-limit hashes of visitor IPs.
ENQUEUE_HMAC_SECRET=

# Optional: a fine-grained GitHub token with no permissions (public repos,
# read-only). Raises GitHub's limit for repo lookups from 60 to 5,000 an hour.
GITHUB_TOKEN=

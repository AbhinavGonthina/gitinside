# Environment variables for apps/web (ADR-0055). NAMES ONLY: never put a value
# in this file or any other file in the repo.
#
# Production values live only in Vercel (Production, marked Sensitive).
# Development points these at Docker Postgres (infra/docker-compose.dev.yml,
# whose local-only URL is in that file) and a local storage stand-in
# (M5.5), never at production.
#
# /api/analyze reads DATABASE_URL, WORKER_URL, ENQUEUE_HMAC_SECRET, the GCP_*
# queue variables, and the optional GITHUB_TOKEN; without any of the required
# ones it answers "temporarily unavailable" (ADR-0066, ADR-0141). /api/graph
# reads DATABASE_URL and the SNAPSHOTS_* variables; repo pages need
# DATABASE_URL, plus the queue to re-analyze new commits (ADR-0068). /api/jobs
# reads only DATABASE_URL (ADR-0139). Locally, LOCAL_TASKS replaces the GCP_*
# variables (below).
# `pnpm --filter @gitinside/db migrate` reads
# DATABASE_URL_UNPOOLED, else DATABASE_URL.

# Neon pooled connection string (serverless functions).
DATABASE_URL=
# Neon direct connection string (migrations only).
DATABASE_URL_UNPOOLED=

# Oracle Object Storage (snapshots, ADR-0095): namespace, region identifier
# (e.g. us-ashburn-1), a Customer Secret Key, and the bucket.
SNAPSHOTS_NAMESPACE=
SNAPSHOTS_REGION=
SNAPSHOTS_ACCESS_KEY_ID=
SNAPSHOTS_SECRET_ACCESS_KEY=
SNAPSHOTS_BUCKET=

# The worker's Cloud Run service URL, an https origin (https://<service>-<hash>.
# <region>.run.app). Cloud Tasks pushes each job to its /run (ADR-0141).
WORKER_URL=
# Shared HMAC key the jobs are signed with: 32 random bytes, base64url. Also
# keys the rate-limit hashes of visitor IPs.
ENQUEUE_HMAC_SECRET=

# Cloud Tasks (ADR-0114, ADR-0141), all required to analyze. Not secrets: names.
# Project ID, the queue's region (e.g. us-east4), and the queue ID.
GCP_PROJECT_ID=
GCP_REGION=
GCP_TASKS_QUEUE=
# Workload Identity Federation provider, full name:
# //iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
GCP_WORKLOAD_IDENTITY_PROVIDER=
# The service account Vercel becomes (it may only create tasks), and the one
# Cloud Tasks signs each push as (the worker's only invoker).
GCP_ENQUEUE_SERVICE_ACCOUNT=
GCP_INVOKER_SERVICE_ACCOUNT=
# Vercel's OIDC token. On Vercel it comes with each request (x-vercel-oidc-token),
# used for that request only, and this stays unset; locally, `vercel env pull`
# writes it (it expires: pull again when Google refuses it).
VERCEL_OIDC_TOKEN=

# Local development without Google (ADR-0149): leave every GCP_* variable
# unset, set WORKER_URL to the local worker (http://127.0.0.1:8080), give both
# apps the same ENQUEUE_HMAC_SECRET, and set LOCAL_TASKS=push. Jobs are then
# pushed straight to the worker's /run as Cloud Tasks would push them. Only a
# localhost/127.0.0.1/[::1] WORKER_URL works, and never on Vercel.
LOCAL_TASKS=

# Optional: a fine-grained GitHub token with no permissions (public repos,
# read-only). Raises GitHub's limit for repo lookups from 60 to 5,000 an hour.
GITHUB_TOKEN=

# Cloudflare Turnstile, the bot check on Analyze (ADR-0157): asked for only when
# an address or the whole site requests more new analyses an hour than people
# usually do. Set both or neither: with neither, nobody is asked; with only one,
# /api/analyze answers "temporarily unavailable". Cloudflare's test keys
# (site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA)
# always pass, for local checks.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The GitHub App (ADR-0220): sign-in, private repos, and the PR bot (M8).
# Production values live only in Vercel; local development and tests use keys
# generated per test against a fake GitHub, never these. App ID, slug (the
# github.com/apps/<slug> part), and client ID are not secrets.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's private key: the whole PEM text, BEGIN and END lines included.
GITHUB_APP_PRIVATE_KEY=
# Webhook secret: 32 random bytes, base64url, the same value as in the app's
# settings. During a rotation the old one goes in ..._PREVIOUS.
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_WEBHOOK_SECRET_PREVIOUS=
# Keys sign-in (M8.2, ADR-0221): seals the stored GitHub tokens and signs the
# sign-in state cookie. 32 random bytes, base64url. Sign-in also needs
# DATABASE_URL, GITHUB_APP_CLIENT_ID, and GITHUB_APP_CLIENT_SECRET.
SESSION_SECRET=
# Tests only (ADR-0223): send the server's GitHub calls to a fake on this
# machine (the E2E's e2e/github.ts). Only http://127.0.0.1:<port> or
# http://localhost:<port> is taken. Never set in production.
GITHUB_FAKE_ORIGIN=

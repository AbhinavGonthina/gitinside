# Environment variables for apps/web (ADR-0055). NAMES ONLY: never put a value
# in this file or any other file in the repo.
#
# Production values live only in Vercel (Production, marked Sensitive).
# Development will point these at Docker Postgres and a local storage
# stand-in (M5.3–M5.5), never at production.
#
# Nothing reads these yet (M5.2 is the scaffold); M5.3+ wire them in.

# Neon pooled connection string (serverless functions).
DATABASE_URL=
# Neon direct connection string (migrations only).
DATABASE_URL_UNPOOLED=

# Cloudflare R2 (snapshots), token scoped to the one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The worker's enqueue API (https://worker.gitinside.abhinavgonthina.dev).
WORKER_URL=
# Shared HMAC key for enqueue requests: 32 random bytes, base64url.
ENQUEUE_HMAC_SECRET=

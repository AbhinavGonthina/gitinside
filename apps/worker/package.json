{
  "name": "@gitinside/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hmac": {
      "types": "./dist/hmac.d.ts",
      "import": "./dist/hmac.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gitinside/analyzer": "workspace:*",
    "@gitinside/schema": "workspace:*",
    "bullmq": "6.4.2",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "2.1.8",
    "supertest": "7.1.4",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}

# The worker's environment (apps/worker/src/config.ts, ADR-0055, ADR-0065).
# Names only: real values live in the VM's root-only /etc/gitinside/worker.env, never
# in the repo. infra/oracle/compose.yml sets REDIS_URL, JOBS_ROOT, HOST, and PORT itself.

# Required
REDIS_URL=redis://redis:6379
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gitinside-snapshots
ENQUEUE_HMAC_SECRET=

# Optional
# ENQUEUE_HMAC_SECRET_PREVIOUS=   (only during a secret rollover)
# JOBS_ROOT=/tmp/jobs
# HOST=127.0.0.1                  (the container sets 0.0.0.0 behind Caddy)
# PORT=8080
# GITHUB_TOKEN=                   (sent to GitHub's API only)

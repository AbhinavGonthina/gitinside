# The worker's environment (apps/worker/src/config.ts, ADR-0055, ADR-0065, ADR-0144).
# Names only: real values live in the deployment's secret store, never in the repo.
# The worker serves Cloud Tasks pushes on POST /run (ADR-0114); there is no Redis.

# Required
DATABASE_URL=
# Oracle Object Storage (snapshots, ADR-0095): the tenancy's namespace and region name
# the S3-compatible endpoint; the keys are a Customer Secret Key.
SNAPSHOTS_NAMESPACE=
SNAPSHOTS_REGION=
SNAPSHOTS_ACCESS_KEY_ID=
SNAPSHOTS_SECRET_ACCESS_KEY=
SNAPSHOTS_BUCKET=gitinside-snapshots
# The same value as the website's: it signs every task's body (hmac.ts).
ENQUEUE_HMAC_SECRET=

# Optional
# ENQUEUE_HMAC_SECRET_PREVIOUS=   (only during a secret rollover)
# JOBS_ROOT=/tmp/jobs
# HOST=127.0.0.1                  (a container sets 0.0.0.0)
# PORT=8080                       (Cloud Run sets it)
# GITHUB_TOKEN=                   (sent to GitHub's API only)

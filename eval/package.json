{
  "name": "@gitinside/eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "validate": "node dist/validate.js",
    "eval": "node dist/run.js",
    "review-sample": "node dist/review.js",
    "draw": "node dist/drawCli.js",
    "backtest:prs": "node dist/backtest/listCli.js",
    "backtest:replay": "node dist/backtest/replayCli.js",
    "backtest:followup": "node dist/backtest/followUpCli.js",
    "backtest:report": "node dist/backtest/reportCli.js"
  },
  "dependencies": {
    "@gitinside/analyzer": "workspace:*",
    "@gitinside/diff": "workspace:*",
    "@gitinside/schema": "workspace:*",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}

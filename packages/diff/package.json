    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gitinside/schema": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.8",
    "fast-check": "3.23.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}

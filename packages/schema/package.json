    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "TEST_DATABASE_URL", "TEST_REDIS_URL"]
    },
    "coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["CI", "TEST_DATABASE_URL", "TEST_REDIS_URL"]
    }
  }
}

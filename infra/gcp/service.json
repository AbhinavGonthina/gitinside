{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "gitinside-worker",
    "labels": {
      "cloud.googleapis.com/location": "us-east4"
    },
    "annotations": {
      "run.googleapis.com/ingress": "internal",
      "run.googleapis.com/launch-stage": "GA"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "autoscaling.knative.dev/minScale": "0",
          "autoscaling.knative.dev/maxScale": "2",
          "run.googleapis.com/execution-environment": "gen2",
          "run.googleapis.com/cpu-throttling": "true",
          "run.googleapis.com/startup-cpu-boost": "false"
        }
      },
      "spec": {
        "containerConcurrency": 1,
        "timeoutSeconds": 300,
        "serviceAccountName": "gitinside-worker@gitinside-513223.iam.gserviceaccount.com",
        "containers": [
          {
            "image": "{{IMAGE}}",
            "ports": [{ "name": "http1", "containerPort": 8080 }],
            "resources": {
              "limits": { "cpu": "1", "memory": "4Gi" }
            },
            "env": [
              { "name": "SNAPSHOTS_NAMESPACE", "value": "{{SNAPSHOTS_NAMESPACE}}" },
              { "name": "SNAPSHOTS_REGION", "value": "{{SNAPSHOTS_REGION}}" },
              { "name": "SNAPSHOTS_BUCKET", "value": "{{SNAPSHOTS_BUCKET}}" },
              { "name": "SNAPSHOTS_ACCESS_KEY_ID", "value": "{{SNAPSHOTS_ACCESS_KEY_ID}}" },
              {
                "name": "DATABASE_URL",
                "valueFrom": { "secretKeyRef": { "name": "worker-database-url", "key": "latest" } }
              },
              {
                "name": "SNAPSHOTS_SECRET_ACCESS_KEY",
                "valueFrom": {
                  "secretKeyRef": { "name": "worker-snapshots-secret-key", "key": "latest" }
                }
              },
              {
                "name": "ENQUEUE_HMAC_SECRET",
                "valueFrom": { "secretKeyRef": { "name": "enqueue-hmac-secret", "key": "latest" } }
              },
              {
                "name": "GITHUB_TOKEN",
                "valueFrom": { "secretKeyRef": { "name": "worker-github-token", "key": "latest" } }
              }
            ],
            "startupProbe": {
              "httpGet": { "path": "/health", "port": 8080 },
              "periodSeconds": 2,
              "timeoutSeconds": 1,
              "failureThreshold": 30
            }
          }
        ]
      }
    }
  }
}
